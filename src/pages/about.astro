---
import educations from "../collections/educations.json";
import experiences from "../collections/experiences.json";
import AboutExperience from "../components/about-experience.astro";
import Card from "../components/card.astro";
import PageHeading from "../components/page-heading.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="Sobre mim | Dev Gui">
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="Sobre mim"
      description={`
        Opa! Me chamo Guilherme França. Sou programador, lider técnico e empreendedor aqui em São Paulo. Transformo desafios complexos de negócio em plataformas SaaS escaláveis, ecossistemas de dados e soluções com inteligência artificial.
      `}
    />

    <img
      src="/assets/images/about.png"
      class="relative z-30 w-full my-10 rounded-xl"
      alt="Guilherme França"
    />

    <p class="text-sm leading-6 text-neutral-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg">
      Com mais de 10 anos de experiência em tecnologia, evoluí da engenharia de
      base até a coordenação e liderança técnica de times de desenvolvimento.
      Além da atuação corporativa liderando arquitetura e engenharia de dados,
      sou criador de produtos próprios como o{" "}
      <a
        href="https://github.com/guiireal/takeshi-bot"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
      >
        Takeshi Bot
      </a>{" "}
      e a{" "}
      <a
        href="https://api.spiderx.com.br/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
      >
        Spider API
      </a>
      .
    </p>

    <h2 class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200">
      Experiência profissional
    </h2>
    <div class="px-5 py-10">
      {experiences.map((experience) => {
        return (
          <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
            <AboutExperience
              dates={experience.dates}
              role={experience.role}
              company={experience.company}
              description={experience.description}
              logo={experience.logo}
            />
          </div>
        );
      })}
    </div>

    <h2 class="mb-2 text-2xl font-bold lg:mt-5 sm:mt-6 dark:text-neutral-200">
      Formação acadêmica
    </h2>

    <div class="z-50 flex flex-col items-stretch w-full gap-5 my-8">
      {educations.map((education) => (
        <Card
          title={education.title}
          description={education.description}
          footer={education.footer}
        />
      ))}
    </div>
  </section>
</Layout>
